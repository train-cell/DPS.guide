{
  "name": "dps-guide-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "DPS.guide monorepo",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.15.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "tsc --build && tsc --noEmit -p apps/mobile/tsconfig.node.json",
    "test": "node scripts/test-lock.mjs vitest run --pool=forks --maxWorkers=1",
    "test:lane": "node scripts/test-lane.mjs --lane",
    "test:smoke": "node scripts/test-lock.mjs vitest run apps/mobile/src/testing/master-smoke-runner.test.ts",
    "test:e2e": "playwright test --config apps/mobile/playwright.config.ts",
    "typecheck": "tsc --build && tsc --noEmit -p apps/mobile/tsconfig.node.json",
    "mobile:dev": "node scripts/start-local.mjs",
    "mobile:start": "node scripts/start-local.mjs --production",
    "mobile:build": "pnpm --filter @dps/mobile build",
    "mobile:android": "node scripts/build-native.mjs android",
    "mobile:ios": "node scripts/build-native.mjs ios",
    "lint": "eslint .",
    "check:ownership": "node scripts/check-ownership.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.13.9",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.21.0",
    "prettier": "^3.5.3"
  }
}
